# Copy this to .env on the server and fill in real values.
#
#   scp .env.prod.example user@SERVER_IP:~/diploma/.env
#   nano ~/diploma/.env

# ── Versions ──────────────────────────────────────────────────
VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT (must match between auth_service and all backends) ────
APP_JWT_SECRET=CHANGE_ME_BASE64_SECRET_MIN_32_CHARS

# ── Ports ─────────────────────────────────────────────────────
NGINX_PORT=80

# ── Security ──────────────────────────────────────────────────
# Set to true in production to require Bearer tokens on all API calls
APP_SECURITY_JWT_ENABLED=false
