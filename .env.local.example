# =============================================================
# .env.local.example — LOCAL DEV тохиргоо
#
# Хэрэглэх:
#   cp .env.local.example .env
#   docker compose up -d --build
#   http://localhost:9090 дээр нээнэ
# =============================================================

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── JWT ──────────────────────────────────────────────────────
APP_JWT_SECRET=YW5kMTIzNDU2Nzg5MGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6MTIzNDU2Nzg5MA==
APP_SECURITY_JWT_ENABLED=false

# ── Nginx ────────────────────────────────────────────────────
# 9090 ашиглана — port 80 Linux-д root эрх, Mac/Windows-д conflict гаргадаг
NGINX_PORT=9090

# ── Frontend API URLs ─────────────────────────────────────────
# Бүгд nginx-ээр дамжина (NGINX_PORT-тай тааруулсан)
VITE_API_AUTH=http://localhost:9090
VITE_API_USER=http://localhost:9090
VITE_API_TOPIC=http://localhost:9090
VITE_API_WORKFLOW=http://localhost:9090
VITE_API_COMMITTEE=http://localhost:9090
VITE_API_THESIS=http://localhost:9090
VITE_API_EVALUATION=http://localhost:9090
VITE_API_NOTIFICATION=http://localhost:9090
VITE_API_REPORT=http://localhost:9090
VITE_API_MESSAGE=http://localhost:9090
VITE_API_ANALYTIC=http://localhost:9090
VITE_API_GRADING=http://localhost:9090

# ── Seed ─────────────────────────────────────────────────────
SEED_PASSWORD=Num2026!
