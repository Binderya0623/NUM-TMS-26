# Build context exclusions for Dockerfile.jsf-host.
# This file is used instead of .dockerignore when building the jsf_host image.
# jsf-host/, module-*/, shared-ui-module/ are intentionally NOT excluded here.

# Dependencies rebuilt inside Docker — no need to send them
**/node_modules/
**/dist/
**/.vite/
**/target/
**/.mvn/wrapper/maven-wrapper.jar.lck

# IDE / OS noise
**/.idea/
**/.vscode/
**/.DS_Store
**/*.iml

# Git
.git
.gitignore
.gitattributes

# Spring Boot services — not needed for the frontend/JSF build
user_service/
topic_service/
committee_service/
thesis_service/
workflow_service/
evaluation_service/
notification_service/
report_service/
message_service/
analytic_service/
grading_service/
num_auth-main/

# Data / seed files
students.json
students_register.json
teachers_full.json
teachers.json
teachers_register.json

# Docs and logs
**/*.log
**/*.pdf
**/*.xlsx
**/*.tex
infra/
logs/
