# =============================================================
# .env.example — root environment for `docker compose up`.
# Copy to `.env` (NEVER commit the result), edit, then bring up.
# =============================================================

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Kafka (PLAINTEXT broker port exposed to host) ────────────
KAFKA_PORT=9092

# ── JSF host (Tomcat) ────────────────────────────────────────
JSF_HOST_PORT=8080

# ── auth-service ─────────────────────────────────────────────
AUTH_PORT=8887

# ── JWT — MUST match across all services and auth-service.
# Generate a fresh value in production, e.g.:
#   openssl rand -base64 64 | tr -d '\n'
# Then set the same value here AND override JWT_SECRET on auth-service.
APP_JWT_SECRET=YW5kMTIzNDU2Nzg5MGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6MTIzNDU2Nzg5MA==

# Backend JWT validation. Default OFF so existing dev clients keep working.
# Flip to true once seeded users have logged in and the frontend has a token.
APP_SECURITY_JWT_ENABLED=false

# ── Frontend backend base URLs (baked into the JSF host image at build) ──
# For localhost deploy keep the defaults. For a non-localhost server, set
# these to public hostnames (no trailing slash). Whatever you put here will
# end up in the bundle the browser fetches.
#
# Examples for a server at thesis.example.com sharing one origin with TLS:
#   VITE_API_AUTH=https://thesis.example.com/api/auth
#   VITE_API_USER=https://thesis.example.com/api/user
#   ...
# (You'd front it with nginx and proxy each /api/* to the matching service.)
VITE_API_AUTH=http://localhost:8887
VITE_API_USER=http://localhost:8086
VITE_API_TOPIC=http://localhost:8081
VITE_API_WORKFLOW=http://localhost:8084
VITE_API_COMMITTEE=http://localhost:8082
VITE_API_THESIS=http://localhost:8083
VITE_API_EVALUATION=http://localhost:8085
VITE_API_NOTIFICATION=http://localhost:8087
VITE_API_REPORT=http://localhost:8088
VITE_API_MESSAGE=http://localhost:8089
VITE_API_ANALYTIC=http://localhost:8090
VITE_API_GRADING=http://localhost:8091

# ── Seed defaults ────────────────────────────────────────────
# Used only by infra/seed.sh. Override per-environment if you don't want
# the demo password baked into the deploy.
SEED_PASSWORD=Num2026!
