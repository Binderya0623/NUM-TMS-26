# =============================================================
# .env.example — root environment for `docker compose up`.
# Copy to `.env` (NEVER commit the result), edit, then bring up.
#
# LOCAL DEV  → copy as-is, defaults work out of the box.
# SERVER DEPLOY → set SERVER_IP to your machine's IP, rotate secrets.
# =============================================================

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432   # uncomment to expose postgres port to host (dev only)

# ── Kafka ────────────────────────────────────────────────────
# KAFKA_PORT=9092      # uncomment to expose kafka port to host (dev only)

# ── JWT — MUST match across all services and auth-service.
# Generate a fresh value for production:
#   openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=YW5kMTIzNDU2Nzg5MGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6MTIzNDU2Nzg5MA==

# Backend JWT validation. Default OFF so existing dev clients keep working.
# Flip to true once seeded users have logged in and the frontend has a token.
APP_SECURITY_JWT_ENABLED=false

# ── Nginx gateway ─────────────────────────────────────────────
# Main entry point. All traffic goes through http://SERVER_IP:80
NGINX_PORT=80

# ── Frontend backend base URLs (baked into the JSF host image at build) ──
# With nginx, ALL VITE_API_* point to the same nginx address.
# nginx routes each /api/<prefix> to the right backend service internally.
#
# LOCAL DEV  (same machine):  keep http://localhost
# SERVER DEPLOY (other machines access): replace localhost with server IP
#   e.g. http://192.168.1.100
#
# No trailing slash. After changing, rebuild jsf_host:
#   docker compose build jsf_host && docker compose up -d jsf_host
VITE_API_AUTH=http://localhost
VITE_API_USER=http://localhost
VITE_API_TOPIC=http://localhost
VITE_API_WORKFLOW=http://localhost
VITE_API_COMMITTEE=http://localhost
VITE_API_THESIS=http://localhost
VITE_API_EVALUATION=http://localhost
VITE_API_NOTIFICATION=http://localhost
VITE_API_REPORT=http://localhost
VITE_API_MESSAGE=http://localhost
VITE_API_ANALYTIC=http://localhost
VITE_API_GRADING=http://localhost

# ── Port overrides (optional, local dev only) ─────────────────
# JSF_HOST_PORT=8080
# AUTH_PORT=8887

# ── Seed defaults ─────────────────────────────────────────────
# Used only by infra/seed.sh.
SEED_PASSWORD=Num2026!
